<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special access granted in Settings. Needed so Unscroll appears in the Usage access list. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Timer overlay (M4) and block screen (M5). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Runtime permission on Android 13+. Optional: tracking works without it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- TrackingService keeps session tracking alive in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Start tracking after a reboot or an update, unless the user turned it off. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- The privacy promise: Unscroll never goes online. No library may add INTERNET. Play Billing
         talks to the Play Store app over IPC and doesn't need it; its bundled telemetry transport
         (com.google.android.datatransport) asks for INTERNET and is rejected here, so it can't send
         anything. CI checks the merged manifest. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- Package visibility (Android 11+): every app with a launcher icon, so the user can add any
         of them, plus home screens (never blocked). No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Home screens, so they can never be blocked. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".UnscrollApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Unscroll"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Unscroll.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Block screen: its own task over the home screen, never in Recents. -->
        <activity
            android:name=".ui.block.BlockActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Unscroll" />

        <!-- Take-a-break screen after N swipes (M7): same task setup as the block screen. -->
        <activity
            android:name=".ui.scroll.BreakActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Unscroll" />

        <!--
            Optional scroll counting (M7). Only enabled by the user in Accessibility settings, after
            the in-app disclosure. See res/xml/accessibility_service_config.xml for its limits.
        -->
        <service
            android:name=".service.ScrollAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            Optional section blocking (Unscroll Plus). A separate service because it needs
            canRetrieveWindowContent; only enabled by the user after its own in-app disclosure.
            See res/xml/section_blocking_service_config.xml for its limits.
        -->
        <service
            android:name=".service.SectionBlockingService"
            android:exported="false"
            android:label="@string/section_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/section_blocking_service_config" />
        </service>

        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Times how long the user spends in social media apps they chose to limit, to show a live session timer and enforce their own limits. Only app package names and timestamps are read." />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- A timed block ("Block entire app" / "Block reels only") ran out: turn it off. -->
        <receiver
            android:name=".service.BlockExpiryReceiver"
            android:exported="false" />
    </application>

</manifest>
