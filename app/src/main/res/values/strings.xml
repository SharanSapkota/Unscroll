    <!-- Section blocking (Unscroll Plus, opt-in accessibility service) -->
    <string name="section_service_label">Unscroll section blocking</string>
    <string name="section_service_description">Checks which section of the apps you choose is open (for example Reels or chat), so Unscroll can cover only the short-video section. It only looks at technical screen identifiers, never at your messages, posts or anything you type, and nothing leaves your phone. Optional: turn it off any time.</string>
    <string name="section_title">Section blocking</string>
    <string name="section_name_reels">Reels</string>
    <string name="section_name_for_you">For You</string>
    <string name="section_name_shorts">Shorts</string>
    <string name="section_cover_title_reels">Reels are blocked.</string>
    <string name="section_cover_title_for_you">For You is blocked.</string>
    <string name="section_cover_title_shorts">Shorts are blocked.</string>
    <string name="section_cover_open_chat">Chat is open.</string>
    <string name="section_cover_open_rest">Everything else is open.</string>
    <string name="section_cover_back_chat">Take me back to chat</string>
    <string name="section_cover_back">Take me back</string>
    <string name="section_disclosure_title">Block only short videos</string>
    <string name="section_disclosure_intro">Unscroll checks which section of the app is open to block short videos. It never reads your messages or content and sends nothing anywhere.</string>
    <string name="section_disclosure_does_title">What it does</string>
    <string name="section_disclosure_does_body">It uses an Android accessibility service to see which part of an app you chose is open, like Reels, the For You feed or Shorts, and covers only that part. Chat, search, profiles and everything else keep working. To tell the sections apart it looks only at technical identifiers of the screen: the names of its building blocks, which tab is selected, and the app\'s screen name.</string>
    <string name="section_disclosure_does_not_title">What it never does</string>
    <string name="section_disclosure_does_not_body">It never reads your messages, posts, captions, comments, usernames or anything you type. It doesn\'t store what was on screen and sends nothing anywhere: Unscroll has no account and no internet access. It never taps or types for you; it can only go Back or Home when you ask it to.</string>
    <string name="section_disclosure_optional_title">Optional</string>
    <string name="section_disclosure_optional_body">Section blocking is part of Unscroll Plus and off until you turn it on. Everything else in Unscroll works without it, and you can turn it off any time in Settings or in Android\'s Accessibility settings.</string>
    <string name="section_disclosure_next">Next: Android opens Accessibility settings. Tap \"Unscroll section blocking\" and turn it on.</string>
    <string name="section_status_off">Off. Cover only Reels, For You or Shorts and keep chat open.</string>
    <string name="section_status_needs_consent">Turned on in Android settings, but you haven\'t agreed in Unscroll yet. Nothing is checked until you do.</string>
    <string name="section_status_needs_enabling">Almost there: turn on \"Unscroll section blocking\" in Accessibility settings.</string>
    <string name="section_status_active">On. Choose the apps in Apps › an app › Section blocking.</string>
    <string name="section_status_no_apps">On, but no app is chosen yet. Choose them in Apps › an app › Section blocking.</string>
    <string name="section_status_turned_off">Turned off. Nothing is checked or covered.</string>
    <string name="section_status_needs_reenable">Android switched section blocking off. Turn it back on in Accessibility settings.</string>
    <string name="section_turn_off">Turn off section blocking</string>
    <string name="section_turn_on">Turn on section blocking</string>
    <string name="section_withdraw">Stop and remove consent</string>
    <string name="section_panel_note">If Unscroll can\'t tell which section is open, nothing is blocked. Back, Home and Recents always work.</string>
