    <string name="onboarding_welcome_line">Stop doomscrolling.</string>
    <string name="onboarding_permissions_title">Three permissions</string>
    <!-- Trust (onboarding and Settings › Data & privacy). Keep these true: no INTERNET permission
         (the manifest removes it, CI checks the merged manifest), no analytics or crash SDKs, no
         accounts, backups off. Play Billing only talks to the Play Store app and gets no usage data. -->
    <string name="trust_headline">Your data stays on your phone.</string>
    <string name="trust_line">No accounts. No tracking. No selling. Unscroll only looks at how you use the apps you choose, so you can get your time back.</string>
    <string name="trust_footer">We\'re here to get you out of the doomscroll. You can trust us.</string>
    <string name="trust_how">How we protect your data</string>
    <string name="trust_bullet_device">Everything Unscroll records is stored only on this device.</string>
    <string name="trust_bullet_never">We never see or collect your usage.</string>
    <string name="trust_bullet_content">Unscroll never reads your messages, posts or anything you type.</string>
    <string name="trust_bullet_purchases">No accounts. Purchases are handled by Google Play. We never see your usage data.</string>
    <string name="trust_bullet_delete">You can delete all your data any time in Settings.</string>
    <string name="onboarding_why_usage">To see how long you spend in each app.</string>
    <string name="onboarding_why_overlay">To show the timer and the limit screen.</string>
    <string name="onboarding_why_notifications">Optional. For reminders and the tracking status.</string>
